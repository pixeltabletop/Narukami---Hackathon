# Inferencia local con QVAC. Desactivada por defecto a propósito: habilitarla
# descarga unos 2,5 GB del modelo la primera vez, y eso no se hace sin que la
# persona lo decida.
#
# Para verla funcionando:  npm run demo
CHEN_ENABLE_QVAC=0

# Modelo de texto. Alternativa medida: GEMMA4_2B_MULTIMODAL_Q4_K_M
CHEN_QVAC_MODEL=QWEN3_4B_INST_Q4_K_M

# Traza de carga e inferencia en consola.
CHEN_DEBUG=0

# Esta app lee variables del proceso; no carga automáticamente este archivo.
